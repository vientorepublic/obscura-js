{
  "name": "obscura-js",
  "version": "2.0.1",
  "description": "JavaScript code protection tool — obfuscation & anti-debugging inspired by Google reCAPTCHA",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "import": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "sideEffects": false,
  "bin": {
    "obscura-js": "dist/bin/obscura_cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/bin/obscura_cli.js', 0o755)\"",
    "build:watch": "tsc --watch",
    "prepublishOnly": "npm run build && npm test",
    "test": "jest --coverage",
    "lint": "eslint src/ bin/",
    "lint:fix": "eslint src/ bin/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"bin/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"bin/**/*.ts\" \"tests/**/*.ts\"",
    "dev": "ts-node bin/obscura_cli.ts"
  },
  "keywords": [
    "obfuscation",
    "javascript",
    "security",
    "anti-debug",
    "anti-tamper",
    "code-protection",
    "ast",
    "swc"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vientorepublic/obscura-js.git"
  },
  "homepage": "https://github.com/vientorepublic/obscura-js#readme",
  "bugs": {
    "url": "https://github.com/vientorepublic/obscura-js/issues"
  },
  "author": "vientorepublic",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@swc/core": "^1.15.40",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
